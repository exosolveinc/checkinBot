rules_version = '2';

// All Firestore access happens via Cloud Functions using the Firebase
// Admin SDK, which bypasses these rules. No client (web/mobile/Slack)
// reads or writes Firestore directly, so we deny every client request.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
